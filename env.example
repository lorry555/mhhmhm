#*****************************************************************
# LLM and Embedding Model
#*****************************************************************
LLM=llama3.2 #or any Ollama model tag, or a hosted model: gpt-6-luna, claude-opus-5-5, gemini-3.7-flash, bedrock:us.anthropic.claude-opus-5-5
EMBEDDING_MODEL=sentence_transformer #or ollama, openai, aws, or google-genai

#*****************************************************************
# Neo4j
#*****************************************************************
#NEO4J_URI=neo4j://database:7687
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=password

#*****************************************************************
# Langchain
#*****************************************************************
# Optional for enabling Langchain Smith API

#LANGCHAIN_TRACING_V2=true # false
#LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
#LANGCHAIN_PROJECT=#your-project-name
#LANGCHAIN_API_KEY=#your-api-key ls_...

#*****************************************************************
# Ollama
#*****************************************************************
#OLLAMA_BASE_URL=http://host.docker.internal:11434

#*****************************************************************
# OpenAI
#*****************************************************************
# Only required when using an OpenAI LLM (LLM=gpt-...) or EMBEDDING_MODEL=openai

#OPENAI_API_KEY=sk-...

#*****************************************************************
# Anthropic
#*****************************************************************
# Only required when using a Claude LLM (LLM=claude-...)

#ANTHROPIC_API_KEY=sk-ant-...

#*****************************************************************
# AWS
#*****************************************************************
# Only required when using an AWS Bedrock LLM (LLM=bedrock:...) or EMBEDDING_MODEL=aws

#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-east-1

#*****************************************************************
# GOOGLE
#*****************************************************************
# Only required when using a Gemini LLM (LLM=gemini-...) or EMBEDDING_MODEL=google-genai
GOOGLE_API_KEY=
